# Kimi credentials
# Your Kimi Code (Coding Plan) API key — the one you use in Claude Code /
# Cline / opencode. Format: sk-kimi-xxxxxxxxxxxxxxxx
# NOTE: this is NOT a Kimi Open Platform key (platform.kimi.com, sk-xxx).
KIMI_API_KEY=

# Optional friendly label for this account (shown in the TUI header and
# in Telegram messages). Useful when you monitor several coding accounts.
# Leave empty to hide it. (Can also be set in config.toml -> [kimi] name.)
KIMI_ACCOUNT_NAME=

# Telegram (leave empty to disable alerts)
TG_BOT_TOKEN=
TG_CHAT_ID=

# Polling interval (seconds) for the background alert daemon
POLL_INTERVAL=300
